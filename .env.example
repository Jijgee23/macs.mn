# Copy to .env.local (dev) or .env (server). See deploy/README.md.
SITE_URL=http://localhost:3000

# Postgres database "macs_site" (content, admins, quote requests, contact messages)
DATABASE_URL=postgresql://macs_site:CHANGE_ME@localhost:5432/macs_site

# Admin login sessions (openssl rand -base64 32)
SESSION_SECRET=
# First admin, created by `npm run db:seed-admin`; more are added in /admin/users
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Notification email from no_reply@: the team gets NOTIFY_TO (always; defaults to
# contact@infosystems.mn) plus the addresses added in /admin/notify, and the visitor gets a
# separate confirmation. Put extra team addresses in /admin/notify, not here.
# Without SMTP_HOST the email is skipped (requests are still saved).
SMTP_HOST=smtp.mail.mn
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=no_reply@infosystems.mn
SMTP_PASS=
SMTP_FROM="Infosystems LLC <no_reply@infosystems.mn>"
NOTIFY_TO=contact@infosystems.mn

# Google reCAPTCHA v2 checkbox (google.com/recaptcha/admin). Unset = no captcha (dev).
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
