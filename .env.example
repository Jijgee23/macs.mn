# Copy to .env.local (dev) or .env (server). See deploy/README.md.
SITE_URL=http://localhost:3000

# Quote and contact forms are stored by the docs site (macs_documents, /api/site/*).
# On the server use http://127.0.0.1:3000 (docs runs on the same machine).
DOCS_API_URL=https://docs.macs.mn
# Same value as SITE_API_KEY in the docs site's .env (openssl rand -hex 32).
SITE_API_KEY=

NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
