[Unit]
Description=MACS ERP marketing site — macs.mn (Next.js)
After=network.target postgresql.service

[Service]
Type=simple
User=macssite
WorkingDirectory=/srv/macs-site
EnvironmentFile=/srv/macs-site/.env
Environment=PORT=3001
ExecStart=/usr/bin/npm run start
Restart=on-failure
RestartSec=5
# graceful shutdown window so after() callbacks (quote emails) can finish
TimeoutStopSec=30
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
