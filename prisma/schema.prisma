generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/** One top-level content section (see content/schema.ts) in one locale: "mn" | "en" | "all". */
model ContentSection {
  key       String
  locale    String
  data      Json
  updatedAt DateTime @updatedAt
  /** Email of the admin who last saved it */
  updatedBy String?

  @@id([key, locale])
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String?
  passwordHash String
  createdAt    DateTime  @default(now())
  lastLoginAt  DateTime?
}

/** Follow-up state shared by quote requests and contact messages. */
enum RequestStatus {
  NEW
  CONTACTED
  CLOSED
}

/** Price-quote request from /une-sanal. */
model QuoteRequest {
  id        String        @id @default(cuid())
  name      String?
  company   String?
  email     String?
  phone     String?
  /** Ids from quoteProductIds in content/common.ts */
  products  String[]
  message   String?
  status    RequestStatus @default(NEW)
  note      String?
  /** Site language the request came from: "mn" | "en" */
  locale    String        @default("mn")
  ip        String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status, createdAt])
  @@index([ip, createdAt])
}

/** General contact message from /holboo-barih. */
model ContactMessage {
  id        String        @id @default(cuid())
  name      String?
  email     String?
  phone     String?
  /** One of contactTopics in content/common.ts */
  topic     String
  message   String
  status    RequestStatus @default(NEW)
  note      String?
  /** Site language the message came from: "mn" | "en" */
  locale    String        @default("mn")
  ip        String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status, createdAt])
  @@index([ip, createdAt])
}

/** Workflow of a request from an existing MACS customer; every change can be emailed to them. */
enum SupportStatus {
  NEW
  RECEIVED
  IN_PROGRESS
  RESOLVED
  REJECTED
}

/** Request from an existing MACS customer («Та MACS хэрэглэгч бол» on /holboo-barih). */
model SupportRequest {
  id          String              @id @default(cuid())
  company     String
  name        String?
  phone       String
  /** Addresses that receive the confirmation and every status update */
  emails      String[]
  /** One of supportTypes in content/common.ts */
  type        String
  /** One of supportUrgencies in content/common.ts */
  urgency     String
  message     String
  status      SupportStatus       @default(NEW)
  /** Internal note, never sent to the customer */
  note        String?
  /** Last explanation sent to the customer with a status update */
  reply       String?
  /** Site language the request came from: "mn" | "en" */
  locale      String              @default("mn")
  ip          String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  attachments SupportAttachment[]

  @@index([status, createdAt])
  @@index([ip, createdAt])
}

/** File attached to a SupportRequest; downloadable by admins only. */
model SupportAttachment {
  id        String         @id @default(cuid())
  requestId String
  request   SupportRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  name      String
  mime      String
  size      Int
  data      Bytes
  createdAt DateTime       @default(now())

  @@index([requestId])
}

enum PostCategory {
  NEWS
  TIP
}

enum PostStatus {
  DRAFT
  PUBLISHED
}

/** News article or tip at /medee/<slug>. Body fields hold sanitized HTML (lib/sanitize.ts). */
model Post {
  id          String       @id @default(cuid())
  slug        String       @unique
  category    PostCategory
  status      PostStatus   @default(DRAFT)
  titleMn     String
  excerptMn   String
  bodyMn      String
  /** English version is optional; without titleEn the post is not listed on /en */
  titleEn     String?
  excerptEn   String?
  bodyEn      String?
  coverId     String?
  publishedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  updatedBy   String?

  @@index([status, publishedAt])
}

/** Uploaded image, served at /media/<id> (re-encoded to WebP by the upload route). */
model Media {
  id        String   @id @default(cuid())
  mime      String
  data      Bytes
  width     Int
  height    Int
  size      Int
  createdAt DateTime @default(now())
  createdBy String?
}
