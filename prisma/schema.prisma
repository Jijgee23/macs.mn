generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/** One top-level content section (see content/schema.ts) in one locale: "mn" | "en" | "all". */
model ContentSection {
  key       String
  locale    String
  data      Json
  updatedAt DateTime @updatedAt
  /** Email of the admin who last saved it */
  updatedBy String?

  @@id([key, locale])
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String?
  passwordHash String
  createdAt    DateTime  @default(now())
  lastLoginAt  DateTime?
}

/** Follow-up state shared by quote requests and contact messages. */
enum RequestStatus {
  NEW
  CONTACTED
  CLOSED
}

/** Price-quote request from /une-sanal. */
model QuoteRequest {
  id        String        @id @default(cuid())
  name      String?
  company   String?
  email     String?
  phone     String?
  /** Ids from quoteProductIds in content/common.ts */
  products  String[]
  message   String?
  status    RequestStatus @default(NEW)
  note      String?
  /** Site language the request came from: "mn" | "en" */
  locale    String        @default("mn")
  ip        String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status, createdAt])
  @@index([ip, createdAt])
}

/** General contact message from /holboo-barih. */
model ContactMessage {
  id        String        @id @default(cuid())
  name      String?
  email     String?
  phone     String?
  /** One of contactTopics in content/common.ts */
  topic     String
  message   String
  status    RequestStatus @default(NEW)
  note      String?
  /** Site language the message came from: "mn" | "en" */
  locale    String        @default("mn")
  ip        String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status, createdAt])
  @@index([ip, createdAt])
}
